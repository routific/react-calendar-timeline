{
  "name": "@routific/react-calendar-timeline",
  "version": "0.31.0",
  "description": "react calendar timeline",
  "main": "dist/react-calendar-timeline.cjs.js",
  "module": "dist/react-calendar-timeline.es.js",
  "exports": {
    ".": {
      "import": "./dist/react-calendar-timeline.es.js",
      "require": "./dist/react-calendar-timeline.cjs.js"
    },
    "./lib/Timeline.css": "./dist/Timeline.css",
    "./style.css": "./dist/Timeline.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run build:lib",
    "build:demo": "vite build --config vite.demo.config.js",
    "build:lib": "rimraf dist lib && vite build && sass src/lib/Timeline.scss dist/Timeline.css --no-source-map && mkdir -p lib && cp dist/Timeline.css lib/Timeline.css && node ./scripts/write-lib-shim.js",
    "lint": "eslint --ext .js,.jsx ./src",
    "prepublishOnly": "npm run build:lib",
    "start": "vite --config vite.demo.config.js",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "files": [
    "dist",
    "lib"
  ],
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/routific/react-calendar-timeline",
  "repository": {
    "type": "git",
    "url": "https://github.com/routific/react-calendar-timeline.git"
  },
  "author": "Marius Andra <marius.andra@gmail.com>",
  "contributors": [
    {
      "name": "Stanisław Chmiela",
      "email": "sjchmiela@gmail.com"
    },
    {
      "name": "Mike Joyce",
      "url": "https://github.com/mcMickJuice"
    },
    {
      "name": "Samuel Rossetti"
    },
    {
      "name": "amakhrov",
      "url": "https://github.com/amakhrov"
    },
    {
      "name": "Ahmad Ilaiwi",
      "url": "https://github.com/Ilaiwi"
    },
    {
      "name": "dkarnutsch",
      "url": "https://github.com/dkarnutsch"
    },
    {
      "name": "Alex Maclean",
      "url": "https://github.com/acemac"
    },
    {
      "name": "Kevin Mann",
      "url": "https://github.com/kevinmanncito"
    }
  ],
  "license": "MIT",
  "keywords": [
    "react",
    "reactjs",
    "react-component",
    "timeline"
  ],
  "jest": {
    "verbose": true,
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/__tests__/**/*.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/config/jest-setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}"
    ],
    "modulePaths": [
      "<rootDir>/src/",
      "<rootDir>/__tests__"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules",
      "<rootDir>/__tests__/test-utility"
    ],
    "watchPlugins": [
      "jest-watch-typeahead/filename",
      "jest-watch-typeahead/testname"
    ]
  },
  "dependencies": {
    "classnames": "^2.2.6",
    "lodash.isequal": "^4.5.0",
    "lodash.throttle": "^4.1.1",
    "memoize-one": "^5.1.1",
    "react-draggable": "4.4.5",
    "styled-components": "^5.3.5"
  },
  "peerDependencies": {
    "interactjs": "^1.3.4",
    "moment": "*",
    "prop-types": "^15.6.2",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/eslint-parser": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/preset-react": "^7.25.0",
    "@testing-library/dom": "9.3.4",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "14.3.1",
    "@testing-library/user-event": "14.5.2",
    "@types/jest": "29.5.14",
    "@vitejs/plugin-react": "4.3.4",
    "babel-jest": "29.7.0",
    "d3": "^5.12.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^28.8.0",
    "eslint-plugin-react": "^7.35.0",
    "faker": "^4.1.0",
    "interactjs": "^1.3.4",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-watch-typeahead": "2.2.2",
    "jsdom": "20.0.3",
    "moment": "^2.11.1",
    "prettier": "^3.3.3",
    "prop-types": "^15.6.2",
    "randomcolor": "^0.5.3",
    "react": "18.3.1",
    "react-dnd": "^9.3.4",
    "react-dnd-html5-backend": "^9.3.4",
    "react-dom": "18.3.1",
    "react-is": "18.3.1",
    "react-router-dom": "^5.3.4",
    "regenerator-runtime": "^0.13.2",
    "rimraf": "^5.0.10",
    "sass": "1.69.5",
    "vite": "5.4.11"
  }
}
